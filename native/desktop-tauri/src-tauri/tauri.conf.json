{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PopcornTime",
  "version": "1.0.3",
  "identifier": "space.popcorntime.app",
  "build": {},
  "app": {
    "windows": [
      {
        "title": "PopcornTime",
        "url": "https://popcorntime.antideploy.app",
        "width": 1280,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "PopcornTime — stream movies & TV shows",
    "longDescription": "PopcornTime — browse trending movies and TV shows and stream instantly.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
